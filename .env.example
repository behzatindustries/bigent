TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram user or chat IDs allowed to use the bot.
BIGENT_TELEGRAM_ALLOWLIST=
# Optional default working directory for Pi sessions.
BIGENT_CWD=
# Optional override for Bigent state. Defaults to ~/.bigent.
BIGENT_HOME=
BIGENT_PI_API_PROVIDER=
BIGENT_PI_API_KEY=
BIGENT_PI_THINKING=
# Optional loop upper bound for bigent loop and /loop. Defaults to 30.
BIGENT_LOOP_MAX_TURNS=
